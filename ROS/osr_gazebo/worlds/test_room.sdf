<?xml version="1.0"?>
<!-- A 6 m x 6 m walled room with a few obstacles, for testing the LiDAR,
     mapping and navigation. Everything is defined inline (no downloads). -->
<sdf version="1.9">
  <world name="test_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Required for the LiDAR (rendering-based) and the IMU -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls and obstacles: static boxes. Each has the same collision and visual. -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <!-- north / south / east / west walls, 6 m long, 0.1 m thick, 0.5 m high -->
        <collision name="north_c"><pose>3.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.2 0.5</size></box></geometry></collision>
        <visual name="north_v"><pose>3.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.2 0.5</size></box></geometry></visual>
        <collision name="south_c"><pose>-3.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.2 0.5</size></box></geometry></collision>
        <visual name="south_v"><pose>-3.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.2 0.5</size></box></geometry></visual>
        <collision name="east_c"><pose>0 -3.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="east_v"><pose>0 -3.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry></visual>
        <collision name="west_c"><pose>0 3.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="west_v"><pose>0 3.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry></visual>
        <!-- inner partition wall, leaving gaps at both ends -->
        <collision name="partition_c"><pose>0.8 -0.5 0.25 0 0 0</pose><geometry><box><size>0.1 3.0 0.5</size></box></geometry></collision>
        <visual name="partition_v"><pose>0.8 -0.5 0.25 0 0 0</pose><geometry><box><size>0.1 3.0 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="crate">
      <static>true</static>
      <pose>-1.5 1.6 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>2.0 1.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.7 1</ambient><diffuse>0.2 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
