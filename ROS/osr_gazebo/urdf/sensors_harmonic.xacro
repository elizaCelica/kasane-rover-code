<?xml version="1.0"?>
<!-- Simulated sensors for Gazebo Harmonic: a 2D LiDAR on top of the body and an
     IMU at the body center. The world must load the Sensors and Imu systems
     (see worlds/test_room.sdf) or these produce no data.
     LiDAR settings follow the RPLIDAR C1 datasheet (360 deg, 10 Hz, 0.05-12 m);
     the original sensor setup was based on the Zyldras/osr-code fork. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
    </material>

    <!-- Kasane layout: the LiDAR (RPLIDAR C1) sits on a mast at the front of a deck
         that rides on 2 in risers above the body. Heights are measured from the floor,
         like on the real rover, and converted to base_link (the body origin, which
         rests base_link_height above the floor in this sim).
         lidar_height is a launch option so other heights can be compared. -->
    <xacro:arg name="lidar_height" default="0.737"/>             <!-- 29 in -->
    <xacro:property name="lidar_height" value="$(arg lidar_height)"/>
    <xacro:property name="base_link_height" value="0.274"/>      <!-- at rest, sim wheels -->
    <xacro:property name="lidar_x" value="0.15"/>                <!-- mast, forward of center -->
    <xacro:property name="deck_height" value="0.387"/>           <!-- deck top: 13 in body + 2 in risers + 1/4 in plate -->
    <xacro:property name="deck_size_x" value="0.337"/>           <!-- 13.25 in -->
    <xacro:property name="deck_size_y" value="0.254"/>           <!-- 10 in -->
    <xacro:property name="deck_thickness" value="0.006"/>
    <xacro:property name="c1_radius" value="0.028"/>             <!-- RPLIDAR C1: 55.6 mm across -->
    <xacro:property name="c1_height" value="0.041"/>
    <xacro:property name="mast_bottom" value="${deck_height}"/>
    <xacro:property name="mast_top" value="${lidar_height - c1_height / 2}"/>

    <!-- Deck and mast. They collide like the real parts, so the sim rover catches its
         mast under a table just as the real one would. The tiny inertials keep the
         URDF-to-SDF converter from dropping the links. -->
    <joint name="deck_joint" type="fixed">
        <parent link="base_link"/>
        <child link="deck"/>
        <origin xyz="0 0 ${deck_height - deck_thickness / 2 - base_link_height}" rpy="0 0 0"/>
    </joint>
    <link name="deck">
        <visual>
            <geometry><box size="${deck_size_x} ${deck_size_y} ${deck_thickness}"/></geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <geometry><box size="${deck_size_x} ${deck_size_y} ${deck_thickness}"/></geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
    </link>
    <xacro:if value="${mast_top > mast_bottom}">
        <joint name="mast_joint" type="fixed">
            <parent link="base_link"/>
            <child link="mast"/>
            <origin xyz="${lidar_x} 0 ${(mast_bottom + mast_top) / 2 - base_link_height}" rpy="0 0 0"/>
        </joint>
        <link name="mast">
            <visual>
                <geometry><box size="0.024 0.024 ${mast_top - mast_bottom}"/></geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <geometry><box size="0.024 0.024 ${mast_top - mast_bottom}"/></geometry>
            </collision>
            <inertial>
                <mass value="0.01"/>
                <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
            </inertial>
        </link>
    </xacro:if>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="${lidar_x} 0 ${lidar_height - base_link_height}" rpy="0 0 0"/>
    </joint>

    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="${c1_radius}" length="${c1_height}"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${c1_radius}" length="${c1_height}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.11"/>
            <inertia ixx="3.7e-5" ixy="0" ixz="0" iyy="3.7e-5" iyz="0" izz="4.3e-5"/>
        </inertial>
    </link>

    <!-- The fixed joint merges "laser" into base_link inside Gazebo, so
         gz_frame_id keeps the scan labeled with the "laser" frame for ROS -->
    <gazebo reference="laser">
        <sensor name="laser" type="gpu_lidar">
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <topic>scan</topic>
            <gz_frame_id>laser</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>500</samples>  <!-- C1: 5 kHz sampling at 10 Hz = 0.72 deg -->
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.015</stddev>  <!-- C1 accuracy is about +/-30 mm -->
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <!-- IMU on the existing imu_link (defined in osr.urdf.xacro) -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>imu</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <!-- Noise in the range of a decent hobby IMU, so the sim isn't
                 better than the real thing: gyro ~0.1 deg/s, accel ~0.02 m/s^2 -->
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

</robot>
